// console-sandbox.js — Sandbox manager

class ConsoleSandbox {
  constructor() {
    this.sessions = new Map(); // sandbox_id → session
    this.queue = new RedisQueue('sandbox:queue');
    this.topics = new Map(); // sandbox_id → topic
  }

  // 1. Create sandbox session
  createSandbox(userId, scope) {
    const sandboxId = crypto.randomUUID();
    const topic = `sandbox:${sandboxId}`;
    
    const session = {
      id: sandboxId,
      userId: userId,
      scope: scope, // 'auth', 'session', 'edge', 'storage'
      createdAt: Date.now(),
      status: 'pending',
      commands: [],
      results: []
    };
    
    this.sessions.set(sandboxId, session);
    this.topics.set(sandboxId, topic);
    
    return {
      sandboxId: sandboxId,
      topic: topic,
      session: session
    };
  }

  // 2. Execute command in sandbox (queued)
  async executeCommand(sandboxId, command) {
    const session = this.sessions.get(sandboxId);
    if (!session) throw new Error('Sandbox not found');
    
    // Enqueue command
    await this.queue.push({
      sandboxId: sandboxId,
      command: command,
      timestamp: Date.now()
    });
    
    // Subscribe to results
    const topic = this.topics.get(sandboxId);
    return new Promise((resolve, reject) => {
      this.subscribe(topic, (result) => {
        session.results.push(result);
        resolve(result);
      });
    });
  }

  // 3. Process queue (worker)
  processQueue() {
    this.queue.pop(async (job) => {
      const { sandboxId, command } = job;
      const session = this.sessions.get(sandboxId);
      
      // Execute command in isolated context
      const result = await this.executeInSandbox(session.scope, command);
      
      // Publish result to topic
      this.publish(this.topics.get(sandboxId), result);
    });
  }

  // 4. Execute in isolated context (no actual console)
  executeInSandbox(scope, command) {
    // Map command to safe handler
    const handlers = {
      'auth': (cmd) => this.authHandlers[cmd.action](cmd.params),
      'session': (cmd) => this.sessionHandlers[cmd.action](cmd.params),
      'edge': (cmd) => this.edgeHandlers[cmd.action](cmd.params),
      'storage': (cmd) => this.storageHandlers[cmd.action](cmd.params)
    };
    
    const handler = handlers[scope];
    if (!handler) return { error: 'Invalid scope' };
    
    try {
      return handler(command);
    } catch (e) {
      return { error: e.message };
    }
  }

  // 5. Cleanup (TTL-based)
  cleanup() {
    const now = Date.now();
    for (const [id, session] of this.sessions) {
      if (now - session.createdAt > 3600000) { // 1 hour
        this.sessions.delete(id);
        this.topics.delete(id);
      }
    }
  }
}