{
  "name": "@deaf-first/deafauth",
  "version": "2.0.0",
  "private": true,
  "description": "DeafAUTH - Accessible authentication service with MCP server support",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "mcp": "node dist/mcp-server.js",
    "db:setup": "tsx src/db/setup.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "test": "vitest",
    "lint": "eslint . --ext ts --report-unused-disable-directives --max-warnings 0",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf node_modules dist"
  },
  "dependencies": {
    "express": "^5.2.1",
    "cors": "^2.8.5",
    "helmet": "^8.3.0",
    "dotenv": "^18.0.5",
    "pg": "^8.23.1",
    "jsonwebtoken": "^9.0.2",
    "bcrypt": "^6.0.0",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/cors": "^2.8.17",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/bcrypt": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.15.0",
    "eslint": "^10.11.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
